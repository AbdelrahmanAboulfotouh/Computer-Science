/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    Inc16(in=feedback , out=incred );
    Mux16(a=feedback , b=incred , sel=inc , out=incout );
    
    Mux16(a=incout , b=in , sel=load , out=loadout );

    Mux16(a=loadout , b=false , sel=reset , out=next  );


    Or(a=reset , b=load , out=rl );
    Or(a=rl , b=inc , out=genload );

    Register(in=next , load=genload , out =out , out = feedback);
   


    

}